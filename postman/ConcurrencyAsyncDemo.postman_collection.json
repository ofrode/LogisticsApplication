{
  "info": {
    "_postman_id": "c40d4d85-4de6-4ba5-a0bc-2f7c5a64fd55",
    "name": "Concurrency and Async Demo",
    "description": "Postman collection for the new race condition and asynchronous shipment endpoints. Includes a taskId capture script for polling async task status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "asyncTaskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Concurrency",
      "item": [
        {
          "name": "POST {{baseUrl}}/api/concurrency/counter/atomic/increment?times=100",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/counter/atomic/increment?times=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "concurrency",
                "counter",
                "atomic",
                "increment"
              ],
              "query": [
                {
                  "key": "times",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "POST {{baseUrl}}/api/concurrency/counter/synchronized/increment?times=100",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/counter/synchronized/increment?times=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "concurrency",
                "counter",
                "synchronized",
                "increment"
              ],
              "query": [
                {
                  "key": "times",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "GET {{baseUrl}}/api/concurrency/race-condition?threads=64&incrementsPerThread=5000",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/concurrency/race-condition?threads=64&incrementsPerThread=5000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "concurrency",
                "race-condition"
              ],
              "query": [
                {
                  "key": "threads",
                  "value": "64"
                },
                {
                  "key": "incrementsPerThread",
                  "value": "5000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Shipment Async",
      "item": [
        {
          "name": "POST {{baseUrl}}/api/shipments/async/bulk",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var responseJson = pm.response.json();",
                  "",
                  "pm.test('taskId returned', function () {",
                  "    pm.expect(responseJson.taskId).to.exist;",
                  "});",
                  "",
                  "if (responseJson.taskId) {",
                  "    pm.collectionVariables.set('asyncTaskId', responseJson.taskId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"trackingNumber\": \"ASYNC-RACE-A-{{$timestamp}}\",\n    \"originCity\": \"Minsk\",\n    \"destinationCity\": \"Warsaw\",\n    \"status\": \"CREATED\",\n    \"customerId\": 5,\n    \"managerId\": 6,\n    \"vehicleIds\": [2],\n    \"cargoes\": [\n      {\n        \"name\": \"Async Cargo 1\",\n        \"weightKg\": 125.00\n      }\n    ],\n    \"schedule\": {\n      \"orderCreatedAt\": \"2026-04-21T09:00:00\",\n      \"orderReceivedAt\": \"2026-04-21T10:00:00\",\n      \"arrivalAt\": \"2026-04-24T18:00:00\"\n    }\n  },\n  {\n    \"trackingNumber\": \"ASYNC-RACE-B-{{$timestamp}}\",\n    \"originCity\": \"Minsk\",\n    \"destinationCity\": \"Prague\",\n    \"status\": \"RECEIVED\",\n    \"customerId\": 5,\n    \"managerId\": 6,\n    \"vehicleIds\": [2],\n    \"cargoes\": [\n      {\n        \"name\": \"Async Cargo 2\",\n        \"weightKg\": 240.00\n      }\n    ],\n    \"schedule\": {\n      \"orderCreatedAt\": \"2026-04-21T11:00:00\",\n      \"orderReceivedAt\": \"2026-04-21T12:00:00\",\n      \"arrivalAt\": \"2026-04-25T16:00:00\"\n    }\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shipments/async/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipments",
                "async",
                "bulk"
              ]
            }
          }
        },
        {

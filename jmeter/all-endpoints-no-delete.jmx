              <elementProp name="arrivalTo" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">arrivalTo</stringProp>
                <stringProp name="Argument.value">2026-03-15T23:59:59</stringProp>
